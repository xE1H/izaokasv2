# Training output — one folder per run, can be many GB
logs/

# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# Package build artefacts (regenerated by `uv sync`)
*.egg-info/
dist/
build/

# Blender auto-backups
*.blend1
*.blend2

# Hydra's own output tree — train.py disables it, but older runs left one
outputs/

# Your leaderboard team name. Local to your clone, so a fork does not carry
# one team's name to the next.
.lituanicax.json

# Downloaded policy bundles, unpacked and re-run by lituanicax_sdk.verify.
# Organiser-only, one directory per submission, and safe to delete.
.verify/

# Coding-agent scratch files and directories
.codex
.opencode/
.agents/
.flash/
.claude/

# Editor / OS noise
# .vscode/settings.json is committed so everyone shares the editor config;
# everything else VS Code leaves in .vscode/ is local and ignored.
.vscode/*
!.vscode/settings.json
*.swp
*~
*.DS_Store
